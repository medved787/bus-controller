{
  "check_interval_seconds": 10,
  "tcp_timeout_seconds": 3,
  "http_timeout_seconds": 3,
  "slow_threshold_ms": 1000,
  "services": [
    {
      "id": "svc1",
      "name": "service1",
      "host": "",
      "port": 8080,
      "check_type": "tcp",
      "webhook": {
        "url": "https://awx/api/v2/job_templates/1664/gitlab/",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "X-Gitlab-Token": "paste_webhook_key_here"
        },
        "body": "{\"trigger\": \"{{ts}}\"}",
        "hmac_secret": "",
        "hmac_header": ""
      }
    },
    {
      "id": "svc2",
      "name": "service2",
      "host": "",
      "port": 8081,
      "check_type": "http",
      "health_scheme": "http",
      "health_path": "/health",
      "slow_threshold_ms": 300,
      "webhook": {
        "url": "https://awx/api/v2/job_templates/1665/gitlab/",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "X-Gitlab-Token": "paste_webhook_key_here"
        },
        "body": "{\"trigger\": \"{{ts}}\"}",
        "hmac_secret": "",
        "hmac_header": ""
      }
    }
  ]
}